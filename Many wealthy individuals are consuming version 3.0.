async def main():
    # สร้างอินสแตนซ์เครื่องยนต์ Frictionless AI v3.0
    engine = FrictionlessEngineV3(debug_mode=True)

    print("\n--- [Test 1: Normal Zero-Friction Run] ---")
    payload_normal = {
        "command": "PROCESS_HIGH_SPEED_LOGIC",
        "user": "Khun Kamon",
        "simulate_error": False
    }
    result_1 = await engine.execute_frictionless_pipeline(payload_normal)
    print(json.dumps(result_1, indent=2, ensure_ascii=False))

    print("\n--- [Test 2: Sandbox Auto-Healing Run (Logic Collision)] ---")
    payload_error = {
        "command": "EXECUTE_COMPLEX_LEVEL_4_MATRIX",
        "user": "Khun Kamon",
        "simulate_error": True # จำลองการเกิด Error เพื่อทดสอบ Sandbox Healing
    }
    result_2 = await engine.execute_frictionless_pipeline(payload_error)
    print(json.dumps(result_2, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    # รองรับการรันบนทุก Platform (Python 3.10+)
    asyncio.run(main())
